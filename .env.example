PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/nukkad
JWT_SECRET=change-me-in-production
WEB_ORIGIN=http://localhost:3200
# true = OTP is returned in the API response and logged (no SMS sent). Set false once an SMS provider is wired up.
OTP_DEV_MODE=true
# Payments: leave empty for mock mode (instant fake payments, dev only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SMS OTP via MSG91 (used only when OTP_DEV_MODE=false)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
